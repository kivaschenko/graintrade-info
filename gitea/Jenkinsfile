pipeline {
  agent any

  options {
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '10'))
    timeout(time: 90, unit: 'MINUTES')
  }

  triggers {
    // Use Gitea webhook as primary trigger; polling can be added if needed.
    pollSCM('')
  }

  environment {
    REGISTRY = 'gitea.graintrade.info'
    REGISTRY_NAMESPACE = 'kivaschenko'

    IMAGE_BACKEND = "${env.REGISTRY}/${env.REGISTRY_NAMESPACE}/grain-backend"
    IMAGE_FRONTEND = "${env.REGISTRY}/${env.REGISTRY_NAMESPACE}/grain-frontend"
    IMAGE_CHAT_ROOM = "${env.REGISTRY}/${env.REGISTRY_NAMESPACE}/grain-chat-room"
    IMAGE_NOTIFICATIONS = "${env.REGISTRY}/${env.REGISTRY_NAMESPACE}/grain-notifications"
    IMAGE_DATA_PIPELINE = "${env.REGISTRY}/${env.REGISTRY_NAMESPACE}/grain-data-pipeline"
    IMAGE_LANDING_SERVICE = "${env.REGISTRY}/${env.REGISTRY_NAMESPACE}/grain-landing-service"

    DEPLOY_PATH = '/home/kivaschenko/production'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.FULL_SHA = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
          env.SHORT_SHA = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
          // One immutable tag for all services in this pipeline run.
          env.DEPLOY_TAG = env.FULL_SHA
        }
        echo "Deploy tag for all microservices: ${env.DEPLOY_TAG}"
      }
    }

    stage('Prepare Frontend Production Env') {
      steps {
        withCredentials([string(credentialsId: 'frontend-env-production', variable: 'FRONTEND_ENV_PROD')]) {
          sh '''
            set -euo pipefail
            cat > frontend/.env.production <<'EOF'
            ${FRONTEND_ENV_PROD}
            EOF
          '''
        }
      }
    }

    stage('Docker Login') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'gitea-registry-creds',
          usernameVariable: 'REG_USER',
          passwordVariable: 'REG_PASS'
        )]) {
          sh '''
            set -euo pipefail
            echo "$REG_PASS" | docker login "$REGISTRY" -u "$REG_USER" --password-stdin
          '''
        }
      }
    }

    stage('Build & Push All Images') {
      parallel {
        stage('Backend') {
          steps {
            sh '''
              set -euo pipefail
              docker build -t "$IMAGE_BACKEND:$DEPLOY_TAG" ./backend
              docker push "$IMAGE_BACKEND:$DEPLOY_TAG"
            '''
          }
        }

        stage('Frontend') {
          steps {
            sh '''
              set -euo pipefail
              docker build -t "$IMAGE_FRONTEND:$DEPLOY_TAG" ./frontend
              docker push "$IMAGE_FRONTEND:$DEPLOY_TAG"
            '''
          }
        }

        stage('Chat Room') {
          steps {
            sh '''
              set -euo pipefail
              docker build -t "$IMAGE_CHAT_ROOM:$DEPLOY_TAG" ./chat-room
              docker push "$IMAGE_CHAT_ROOM:$DEPLOY_TAG"
            '''
          }
        }

        stage('Notifications') {
          steps {
            sh '''
              set -euo pipefail
              docker build -t "$IMAGE_NOTIFICATIONS:$DEPLOY_TAG" ./notifications
              docker push "$IMAGE_NOTIFICATIONS:$DEPLOY_TAG"
            '''
          }
        }

        stage('Data Pipeline') {
          steps {
            sh '''
              set -euo pipefail
              docker build -t "$IMAGE_DATA_PIPELINE:$DEPLOY_TAG" ./data-pipeline
              docker push "$IMAGE_DATA_PIPELINE:$DEPLOY_TAG"
            '''
          }
        }

        stage('Landing Service') {
          steps {
            sh '''
              set -euo pipefail
              docker build -t "$IMAGE_LANDING_SERVICE:$DEPLOY_TAG" ./landing-service
              docker push "$IMAGE_LANDING_SERVICE:$DEPLOY_TAG"
            '''
          }
        }
      }
    }

    stage('Deploy All Services') {
      steps {
        withCredentials([sshUserPrivateKey(
          credentialsId: 'prod-ssh-key',
          keyFileVariable: 'SSH_KEY',
          usernameVariable: 'SSH_USER'
        )]) {
          withCredentials([
            string(credentialsId: 'prod-host', variable: 'PROD_HOST'),
            string(credentialsId: 'prod-port', variable: 'PROD_PORT')
          ]) {
            sh '''
              set -euo pipefail
              SSH_OPTS="-i $SSH_KEY -o StrictHostKeyChecking=no -p $PROD_PORT"

              ssh $SSH_OPTS "$SSH_USER@$PROD_HOST" "
                set -euo pipefail
                cd '$DEPLOY_PATH'
                TAG='$DEPLOY_TAG' docker compose -f docker-compose.prod.yaml pull
                TAG='$DEPLOY_TAG' docker compose -f docker-compose.prod.yaml up -d
              "
            '''
          }
        }
      }
    }
  }

  post {
    always {
      sh 'docker logout "$REGISTRY" || true'
      cleanWs(deleteDirs: true, notFailBuild: true)
    }
    success {
      echo "Pipeline completed successfully for tag ${env.DEPLOY_TAG}"
    }
    failure {
      echo "Pipeline failed. Check logs above."
    }
  }
}