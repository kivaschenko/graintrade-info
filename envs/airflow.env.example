# ============================================================
# Airflow environment variables — copy to envs/airflow.env
# and fill in real values before deploying.
# Never commit this file with real secrets.
# ============================================================

# -------------------------------------------------------------
# CORE
# -------------------------------------------------------------

# LocalExecutor: tasks run as subprocesses in the scheduler container.
# No Celery or Redis required — perfect for single-server deployments.
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Disable built-in examples to keep the UI clean
AIRFLOW__CORE__LOAD_EXAMPLES=false

# Set to your local timezone for easier log reading
AIRFLOW__CORE__DEFAULT_TIMEZONE=UTC

# -------------------------------------------------------------
# DATABASE (Airflow metadata — separate DB from your app)
# The Airflow metadata DB must be created before first deploy:
#   CREATE DATABASE airflow_db;
#   CREATE USER airflow_user WITH PASSWORD 'your_password';
#   GRANT ALL PRIVILEGES ON DATABASE airflow_db TO airflow_user;
# -------------------------------------------------------------
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow_user:your_db_password@host.docker.internal:5432/airflow_db

# -------------------------------------------------------------
# SECURITY — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -------------------------------------------------------------
AIRFLOW__CORE__FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=REPLACE_WITH_RANDOM_HEX_SECRET

# -------------------------------------------------------------
# WEBSERVER
# -------------------------------------------------------------

# Hide raw config in the Airflow UI
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=false

# Set DAG list page refresh rate (seconds)
AIRFLOW__WEBSERVER__REFRESH_INTERVAL=30

# Worker timeout for webserver Gunicorn workers (seconds)
AIRFLOW__WEBSERVER__WEB_SERVER_WORKER_TIMEOUT=120

# Number of Gunicorn workers for the webserver
# (2 is fine for a single-server deployment with ~5 concurrent users)
AIRFLOW__WEBSERVER__WORKERS=2

# -------------------------------------------------------------
# SCHEDULER
# -------------------------------------------------------------

# How often the scheduler parses DAG files (seconds)
# Increase to reduce CPU usage if DAG count is small
AIRFLOW__SCHEDULER__DAG_DIR_LIST_INTERVAL=60

# Minimum time between successive runs of the same DAG
AIRFLOW__SCHEDULER__MIN_FILE_PROCESS_INTERVAL=30

# Maximum number of tasks the LocalExecutor runs in parallel.
# Each task is a subprocess; limit to avoid memory pressure.
AIRFLOW__CORE__PARALLELISM=8

# Maximum tasks running across all DAGs at once
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=8

# Maximum number of active DAG runs per DAG
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=1

# -------------------------------------------------------------
# LOGGING
# -------------------------------------------------------------
AIRFLOW__LOGGING__LOGGING_LEVEL=WARNING
AIRFLOW__LOGGING__FAB_LOGGING_LEVEL=WARNING

# Keep task logs for 30 days
AIRFLOW__LOG_RETENTION_DAYS=30

# -------------------------------------------------------------
# DATA PIPELINE SERVICE URL
# Injected into DAGs via os.environ.get("DATA_PIPELINE_URL")
# Must match the service name in docker-compose on grain-network
# -------------------------------------------------------------
DATA_PIPELINE_URL=http://data-pipeline:8004

# -------------------------------------------------------------
# ADMIN USER — used by airflow-init service
# Change before first deploy
# -------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@graintrade.info
