# Terraform Variables Example File
# Copy this file to terraform.tfvars and update the values

# ==================== REQUIRED VARIABLES ====================

alert_email = "your-email@example.com"  # Email for CloudWatch alarms

db_password = "YourSecurePassword123!"  # Must be 8+ characters

redis_auth_token = "YourRedisAuthToken1234567890"  # Must be 16+ characters

rabbitmq_password = "YourRabbitMQPassword123!"  # Must be 8+ characters

# ==================== OPTIONAL VARIABLES ====================

# AWS Configuration
aws_region  = "us-east-1"  # AWS region (us-east-1, us-east-2, us-west-1, us-west-2)
app_name    = "graintrade"
environment = "prod"  # dev, staging, or prod

# VPC & Networking
vpc_cidr                = "10.0.0.0/16"
public_subnet_cidrs     = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs    = ["10.0.10.0/24", "10.0.11.0/24"]

# Database Configuration
db_engine_version      = "16.1"
db_instance_class      = "db.t3.micro"      # Free tier: t3.micro, t4.micro
db_allocated_storage   = 20                  # GB (free tier: up to 20GB)
db_storage_type        = "gp3"
db_name                = "graintrade"
db_username            = "postgres"
db_backup_retention    = 7                   # days
enable_multi_az        = false               # Set to true for production
skip_final_snapshot    = false

# Cache Configuration
redis_node_type           = "cache.t3.micro"     # Free tier: t3.micro, t4.micro
redis_num_nodes           = 1
redis_engine_version      = "7.x"
redis_automatic_failover  = false

# Container Registry
force_delete_ecr = false

# ECS Configuration
backend_desired_count  = 1
backend_max_capacity   = 3
chat_desired_count     = 1
chat_max_capacity      = 3
notifications_desired_count = 1

# Logging
log_retention_days = 7  # days

# RabbitMQ Configuration
rabbitmq_username = "graintrade"
rabbitmq_host     = "rabbitmq.example.com"  # Update with your RabbitMQ host
rabbitmq_port     = 5672
