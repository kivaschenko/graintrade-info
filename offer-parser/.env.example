# Offer Parser Service Configuration

# FastAPI Settings
DEBUG=true
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8005

# LLM Configuration (choose one)
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.3

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

# LLM Provider (openai, anthropic, or fallback)
LLM_PROVIDER=fallback

# Redis Configuration (for caching domain vocabulary)
REDIS_URL=redis://localhost:6379/3
REDIS_TIMEOUT=5

# Database Configuration (optional, for logging parsed data)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/graintrade
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Domain Vocabulary (JSON file path or Redis cache)
CROPS_LIST_PATH=./data/crops.json
PORTS_LIST_PATH=./data/ports.json
DELIVERY_TERMS_PATH=./data/delivery_terms.json
REGIONS_LIST_PATH=./data/regions.json

# Parsing Configuration
MIN_CONFIDENCE_THRESHOLD=0.7
ENABLE_REGEX_FALLBACK=true
MAX_TEXT_LENGTH=2000
REQUEST_TIMEOUT=10

# Service Health
HEALTH_CHECK_INTERVAL=30
