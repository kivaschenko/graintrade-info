# src/data_pipeline/.env.example
# Database Configuration
DATABASE_URL=postgresql://data_analytic:password@localhost:5432/analytic_db

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_APP_NAME=GrainTrade-DataPipeline

# Delta Lake Paths
BRONZE_LAYER_PATH=/data/delta/bronze
SILVER_LAYER_PATH=/data/delta/silver
GOLD_LAYER_PATH=/data/delta/gold
PREDICTION_PATH=/data/delta/predictions

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001

# Environment
ENV=development

# Logging
LOG_LEVEL=INFO

# Data Sources
DATA_SOURCES_PATH=./data_sources

# Airflow
AIRFLOW_HOME=./airflow
